# Example Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git!

APP_ENV=development
APP_PORT=8000
DEBUG=true

# Wake Word Settings (models: alexa, hey_jarvis, hey_mycroft, etc.)
WAKEWORD_MODELS=alexa
WAKEWORD_THRESHOLD=0.5

# Voice Activity Detection (VAD) & Recorder Settings
VAD_ENERGY_THRESHOLD=500
VAD_SILENCE_TIMEOUT=1.6
VAD_INITIAL_TIMEOUT=4.0
VAD_MAX_RECORD_TIME=10.0

# Speech-to-Text (STT) Settings (Faster-Whisper)
STT_MODEL_SIZE=base.en
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=en

# Audio Capture Hardware Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1280
# AUDIO_INPUT_DEVICE_INDEX=1
