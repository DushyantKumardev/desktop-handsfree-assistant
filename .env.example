# Example Environment Configuration
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to Git!

APP_ENV=development
APP_PORT=8000
DEBUG=true

# Wake Word Settings (models: alexa, hey_jarvis, hey_mycroft, etc.)
WAKEWORD_MODELS=alexa
WAKEWORD_THRESHOLD=0.5

# Audio Capture Hardware Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1280
# AUDIO_INPUT_DEVICE_INDEX=1
