# Backend Environment Configuration
# Copy this file to .env inside the backend folder and fill in your actual values.
# NEVER commit the real .env file to Git!

APP_ENV=development
APP_PORT=8000
DEBUG=true

# Wake Word Settings (models: alexa, hey_jarvis, hey_mycroft, etc.)
WAKEWORD_MODELS=alexa
WAKEWORD_THRESHOLD=0.5

# Voice Activity Detection (VAD) & Recorder Settings
VAD_ENERGY_THRESHOLD=500
VAD_SILENCE_TIMEOUT=1.6
VAD_INITIAL_TIMEOUT=4.0
VAD_MAX_RECORD_TIME=10.0

# Speech-to-Text (STT) Settings (Faster-Whisper Multilingual)
STT_MODEL_SIZE=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_LANGUAGE=auto

# Text-to-Speech (TTS) Settings (Piper Offline Neural)
TTS_VOICE=en_US-lessac-medium
TTS_SPEED=1.15

# LLM & Intent Engine Settings (OpenAI-compatible: Ollama / OpenRouter / Groq / OpenAI)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2
LLM_API_KEY=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=150
LLM_REASONING_EFFORT=low


# Sound Effects & Audio Cues (placed in backend/assets/sounds/)
SOUND_START_FILE=start.mp3
SOUND_STOP_FILE=stop.mp3

# Web Search (Serper Google Search API - get free key at https://serper.dev)
# If left empty, assistant falls back to free DuckDuckGo & Wikipedia search automatically.
SERPER_API_KEY=

# Audio Capture Hardware Settings
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_SIZE=1280
# AUDIO_INPUT_DEVICE_INDEX=1

